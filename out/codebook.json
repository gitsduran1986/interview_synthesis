    {
      "question_id": "q-02-06",
      "section_id": "02-current-environment",
      "canonical_question": "Was the expansion into modules like asset management, HR and GRC driven top-down by enterprise strategy, or bottom-up by departments identifying pain points?"
    },
    {
      "question_id": "q-02-07",
      "section_id": "02-current-environment",
      "canonical_question": "What makes a custom ITSM solution the right fit for your current company today instead of a commercial platform?"
