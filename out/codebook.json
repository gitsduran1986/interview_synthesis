      "question_id": "q-02-01",
      "section_id": "02-current-environment",
      "canonical_question": "Walk me through how your organization uses the ITSM platform and which modules you have deployed."
    },
    {
      "question_id": "q-02-02",
      "section_id": "02-current-environment",
      "canonical_question": "What drove the original decision to adopt/replace the ITSM platform?"
    },
    {
      "question_id": "q-02-03",
      "section_id": "02-current-environment",
      "canonical_question": "Were those goals part of a broader strategic initiative (e.g. digital transformation / tool consolidation), or mostly an IT-driven project?"
    },
    {
      "question_id": "q-02-04",
      "section_id": "02-current-environment",
      "canonical_question": "You mentioned implementing GRSD — could you clarify which module that was?"
    },
